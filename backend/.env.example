# SERVER
NODE_ENV=development
PORT=8001
CLIENT_URL=http://localhost:5173
# For ngrok/mobile testing, set one of these to your backend ngrok URL.
# PUBLIC_BACKEND_URL=https://YOUR_NGROK_URL
# BASE_URL=https://YOUR_NGROK_URL

# MYSQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=doller_coach
MYSQL_CONNECTION_LIMIT=100

# AUTH
JWT_SECRET=replace_with_a_very_long_random_secret_min_32_chars
REFRESH_TOKEN_SECRET=replace_with_a_very_long_random_refresh_secret_min_32_chars
ADMIN_SECRET=replace_with_min_16_chars
INTERNAL_TEST_SECRET=replace_with_min_32_chars
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8001/api/auth/google/callback

# PAYMENTS
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# FIREBASE
FIREBASE_SERVICE_KEY=

# CACHE_AND_QUEUE
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
MEMORY_CACHE_MAX_KEYS=50000
REDIS_CONNECT_TIMEOUT_MS=1200
REDIS_MAX_RECONNECT_ATTEMPTS=1
ENABLE_QUEUE=false
ENABLE_OUTBOX=false

# EMAIL
BREVO_API_KEY=
MAIL_FROM=Doller Coach <no-reply@example.com>

# SHIPROCKET
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_API_URL=https://apiv2.shiprocket.in/v1/external

# SCALE_LIMITS
LOAD_ACTIVE_REQUEST_LIMIT=5000
LOAD_LAG_THRESHOLD_MS=250
LOAD_RETRY_AFTER_SECONDS=1
API_USER_LIMIT=2000
API_IP_LIMIT=5000
API_SUBNET_LIMIT=15000
AUTH_USER_LIMIT=50
AUTH_IP_LIMIT=100
UPLOAD_USER_LIMIT=120
UPLOAD_IP_LIMIT=240
ROUTE_CACHE_TTL_SECONDS=120
ROUTE_CACHE_TIMEOUT_MS=400
AUTH_CACHE_TTL_SECONDS=300
REQUEST_LOG_SAMPLE_RATE=0.05
SLOW_API_MS=1000
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=66000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_MAX_REQUESTS_PER_SOCKET=1000

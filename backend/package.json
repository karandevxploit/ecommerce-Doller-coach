{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node --max-old-space-size=512 --expose-gc server.js",
    "dev": "nodemon --max-old-space-size=512 --expose-gc server.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "load-test": "node scripts/load-test.js",
    "test:e2e": "node tests/admin_e2e.js",
    "failure-simulate": "node scripts/failure-simulator.js",
    "pm2:start": "pm2 start server.js --name \"ecommerce-backend\" -i max --wait-ready --listen-timeout 15000",
    "pm2:restart": "pm2 restart all",
    "pm2:stop": "pm2 stop all",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "validate": "node utils/internal/startup-validation.js",
    "health-check": "curl -f http://localhost:8001/api/health",
    "metrics": "curl -f http://localhost:8001/api/metrics",
    "deep-health": "curl -f http://localhost:8001/api/health/deep",
    "seed:admin": "node scripts/seedAdmin.js",
    "clear-port": "node scripts/clearPort.js",
    "worker": "node services/worker.service.js",
    "load-test:public": "npx autocannon -c 200 -d 30 http://localhost:8001/api/products",
    "load-test:auth": "npx autocannon -c 200 -d 30 -H \"Authorization: Bearer test_token\" http://localhost:8001/api/auth/profile",
    "prestart": "node scripts/cleanup-lock.js && npm run validate"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@sparticuz/chromium-min": "^143.0.4",
    "@tanstack/react-query": "^5.99.0",
    "autocannon": "^7.11.0",
    "axios": "^1.6.7",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.73.4",
    "chalk": "^4.1.2",
    "cloudinary": "^1.41.3",
    "compression": "^1.7.5",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.6.1",
    "docx-pdf": "^0.0.1",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.3.2",
    "firebase-admin": "^12.0.0",
    "google-auth-library": "^9.6.3",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "html-pdf": "3.0.1",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.3.5",
    "mongodb": "^6.3.0",
    "mongoose": "^8.1.4",
    "mongoose-paginate-v2": "^1.8.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cache": "^5.1.2",
    "nodemailer": "^6.9.8",
    "nodemon": "^3.1.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.18.0",
    "pino": "^8.14.1",
    "pino-pretty": "^10.0.0",
    "pizzip": "^3.2.0",
    "puppeteer-core": "^24.40.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "razorpay": "^2.9.6",
    "redlock": "^5.0.0-beta.2",
    "sib-api-v3-sdk": "^8.5.0",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xss-clean": "^0.1.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "mongodb-memory-server": "^11.0.1",
    "puppeteer": "^24.42.0",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "ecommerce",
    "backend",
    "api",
    "production",
    "monitoring",
    "observability",
    "load-testing",
    "health-checks",
    "metrics"
  ],

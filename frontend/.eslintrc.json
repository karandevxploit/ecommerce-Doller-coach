{
  "extends": [
    "@eslint/js",
    "plugin:tailwindcss/recommended"
  ],
  "plugins": [
    "tailwindcss"
  ],
  "rules": {
    "tailwindcss/no-custom-classname": "off",
    "tailwindcss/enforces-negative-arbitrary-values": "off"
  },
  "overrides": [
    {
      "files": ["*.css"],
      "rules": {
        "tailwindcss/at-apply-no-important": "off"
      }
    }
  ]
}

# Server Configuration
VITE_API_URL=http://localhost:8001/api
NODE_ENV=development

# Google OAuth (NEVER commit real values to version control)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Google reCAPTCHA (NEVER commit real values to version control)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Analytics (Optional - add if needed)
# VITE_GA_TRACKING_ID=your_ga_tracking_id_here

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=false

# Security Settings
VITE_API_TIMEOUT=30000
VITE_CACHE_TTL=30000
